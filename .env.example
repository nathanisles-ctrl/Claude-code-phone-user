# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Notion (optional) ─────────────────────────────────────────────────────────
# Get from: notion.so/my-integrations → Create integration → copy secret
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx
# The 32-char hex ID from your Notion database URL
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ElevenLabs ────────────────────────────────────────────────────────────────
# Get from: elevenlabs.io → Profile → API key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Default voice (Rachel). Find IDs at: elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Higgsfield ────────────────────────────────────────────────────────────────
# Get from: higgsfield.ai → Settings → API
HIGGSFIELD_API_ID=your_higgsfield_api_id_here
HIGGSFIELD_API_SECRET=your_higgsfield_api_secret_here
# Override if Higgsfield updates their API base URL
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=output

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./studio.sqlite3
